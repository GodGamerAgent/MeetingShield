# Quorum — example environment. Copy to .env and adjust; ./start.sh loads it automatically.
# Placeholder values only. Never commit a real .env.

# LM Studio (OpenAI-compatible local server) running Gemma 4
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=google/gemma-4-26b-a4b-qat

# Backend storage (optional overrides)
# QUORUM_DB_PATH=/absolute/path/to/quorum.db
# QUORUM_AUDIO_DIR=/absolute/path/to/recordings
# QUORUM_CONFIG_FILE=/absolute/path/to/config.json

# Web dashboard -> backend (optional overrides)
# QUORUM_BACKEND_URL=http://127.0.0.1:8000
# NEXT_PUBLIC_QUORUM_WS_URL=ws://localhost:8000
